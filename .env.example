# env variablesMCP RAG Server
# ==========================================

# Configuration Ollama
API_KEY=ollama

# LLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3

# Embedding (modele par defaut, utilise si EMBED_*_CODE / EMBED_*_TEXT sont absents)
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text

# Embedding CODE (optionnel) - modele specialise pour Python/C++/Proto
# Fallback sur EMBED_MODEL/EMBED_BASE_URL/API_KEY si non renseigne.
#EMBED_MODEL_CODE=jina-embeddings-v2-base-code
#EMBED_BASE_URL_CODE=http://localhost:11434/v1
#EMBED_API_KEY_CODE=ollama

# Embedding TEXTE (optionnel) - modele pour PDF/Markdown
# Fallback sur EMBED_MODEL/EMBED_BASE_URL/API_KEY si non renseigne.
#EMBED_MODEL_TEXT=nomic-embed-text
#EMBED_BASE_URL_TEXT=http://localhost:11434/v1
#EMBED_API_KEY_TEXT=ollama

# Chemin vers le certificat SSL (requis)
PATH_CA=/path/to/ca.crt

# Logs (optionnel)
PATH_LOGS=./logs

# ChromaDB - persistance directory (optionnel, default: ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# Embedding - Batch size (optionnel, default: 128)
EMBED_BATCH_SIZE=128

# Retrieval - Nombre de chunks par recherche (optionnel, default: 30)
RETRIEVAL_TOP_K=30
MAX_RERANK=100

# LLM - Taille max du contexte (optionnel, default: 2000)
MAX_CONTEXT_CHARS=2000
MAX_EMBED_CHARS=2000
# Limites specifiques par domaine (optionnel, fallback sur MAX_EMBED_CHARS)
#MAX_EMBED_CHARS_CODE=2000
#MAX_EMBED_CHARS_TEXT=2000

# Conversation - Contexte (optionnel, default: 5)
MAX_HISTORY_TURNS=5